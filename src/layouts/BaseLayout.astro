---
import Footer from '../components/layout/Footer.astro'
import Header from '../components/layout/Header.astro'
import '../styles/global.css'
import type { Translations } from '../i18n/pt'

interface Props {
  title: string
  description?: string
  t: Translations
  currentLang: string
}

const { title, description = 'awakr — sua presença digital', t, currentLang } = Astro.props
---

<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="awakr" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      const theme = localStorage.getItem('theme') ??
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      document.documentElement.classList.toggle('dark', theme === 'dark')

      function updateThemeColor(isDark) {
        document.querySelectorAll('meta[name="theme-color"]').forEach(el => el.remove())
        const meta = document.createElement('meta')
        meta.name = 'theme-color'
        meta.content = isDark ? '#000000' : '#ffffff'
        document.head.appendChild(meta)
      }
      updateThemeColor(theme === 'dark')

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {})
        })
      }
    </script>
  </head>
  <body>
    <Header t={t} currentLang={currentLang} />
    <slot />
    <Footer />
  </body>
</html>
