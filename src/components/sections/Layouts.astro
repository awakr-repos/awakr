---
const layouts = [
  {
    id: 1,
    title: 'Clássico',
    description: 'Elegante e direto. Ideal para restaurantes tradicionais e negócios consolidados.',
    href: '/demo/layout-1',
  },
  {
    id: 2,
    title: 'Moderno',
    description: 'Visual arrojado e contemporâneo. Perfeito para negócios que querem se destacar.',
    href: '/demo/layout-2',
  },
  {
    id: 3,
    title: 'Minimalista',
    description: 'Limpo e objetivo. Foco total no produto e na identidade da marca.',
    href: '/demo/layout-3',
  },
]
---

<section
  id="layouts"
  aria-labelledby="layouts-heading"
  class="py-24 bg-white dark:bg-gray-950"
>
  <div class="max-w-6xl mx-auto px-6">
    <h2 id="layouts-heading" class="text-3xl font-bold text-black dark:text-white">
      Escolha seu layout
    </h2>
    <p class="mt-4 text-gray-600 dark:text-gray-400 text-lg">
      Modelos prontos para personalizar com as cores e identidade do seu negócio.
    </p>

    <ul class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8" role="list">
      {layouts.map(layout => (
        <li class="group border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden hover:border-gray-300 dark:hover:border-gray-600 transition-colors">
          <div class="bg-gray-100 dark:bg-gray-800 h-48 flex items-center justify-center">
            <span class="text-gray-400 dark:text-gray-500 text-sm">Preview do layout {layout.id}</span>
          </div>
          <div class="p-6 bg-white dark:bg-gray-900">
            <h3 class="font-semibold text-lg text-black dark:text-white">{layout.title}</h3>
            <p class="mt-2 text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{layout.description}</p>
            <a
              href={layout.href}
              aria-label={`Ver demonstração do layout ${layout.title}`}
              class="mt-4 inline-block text-sm font-medium underline underline-offset-4 text-black dark:text-white hover:text-gray-600 dark:hover:text-gray-400 transition-colors focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white focus:ring-offset-2"
            >
              Ver demonstração →
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>