---
import type { Translations } from '../../i18n/pt'
interface Props { t: Translations }
const { t } = Astro.props
---

<section aria-labelledby="hero-heading" class="min-h-screen flex items-center pt-16 bg-white dark:bg-gray-950">
  <div class="max-w-6xl mx-auto px-6 py-24">
    <div class="max-w-3xl">
      <span class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-widest">
        {t.hero.eyebrow}
      </span>
      <h1 id="hero-heading" class="mt-4 text-5xl font-bold leading-tight text-black dark:text-white">
        {t.hero.title}
      </h1>
      <p class="mt-6 text-xl text-gray-600 dark:text-gray-400 leading-relaxed">
        {t.hero.description}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="#contato" class="whitespace-nowrap bg-black dark:bg-white text-white dark:text-black px-8 py-4 rounded-full font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white focus:ring-offset-2">
          {t.hero.ctaPrimary}
        </a>
        <a href="#layouts" class="whitespace-nowrap text-black dark:text-white px-8 py-4 rounded-full font-medium border border-gray-200 dark:border-gray-700 hover:border-gray-400 dark:hover:border-gray-500 transition-colors focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white focus:ring-offset-2">
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</section>
