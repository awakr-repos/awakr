---
const navLinks = [
  { label: 'Como funciona', href: '#como-funciona' },
  { label: 'Layouts', href: '#layouts' },
  { label: 'Preços', href: '#precos' },
]
---

<header class="fixed top-0 w-full z-50 bg-white border-b border-gray-100">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-bold text-xl">awakr</a>

    <ul class="flex items-center gap-8">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="text-sm text-gray-600 hover:text-black transition-colors">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a href="#contato" class="text-sm bg-black text-white px-4 py-2 rounded-full hover:bg-gray-800 transition-colors">
      Falar com a gente
    </a>
  </nav>
</header>